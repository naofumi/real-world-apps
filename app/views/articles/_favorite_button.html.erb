<% label = favorited ? "Unfavorite" : "Favorite" %>
<% css = favorited ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-primary" %>
<%= button_to article_favorite_path(article), method: (favorited ? :delete : :post), class: css, form_class: class_names("button_to", dom_id(article, :favorite)), aria: { label: "#{label} #{article.title}" } do %>
  <i class="ion-heart"></i>
  <span class="favorite__count"><%= article.favorites_count %></span>
  <span class="favorite__label">&nbsp;<%= label %> Article <span class="counter">(<%= article.favorites_count %>)</span></span>
<% end %>
