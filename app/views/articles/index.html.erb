<div class="home-page">
  <div class="banner">
    <div class="container">
      <h1 class="logo-font">conduit</h1>
      <p>A place to share your knowledge.</p>
    </div>
  </div>

  <div class="container page">
    <div class="row">
      <div class="col-md-9">
        <%= render "feed_toggle", your_feed: false %>
        <%= render "list", page: @page %>
      </div>
      <div class="col-md-3">
        <%= render "shared/tags", tags: @tags, current: @tag %>
      </div>
    </div>
  </div>
</div>
