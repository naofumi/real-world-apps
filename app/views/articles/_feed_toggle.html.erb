<div class="feed-toggle">
  <ul class="nav nav-pills outline-active">
    <% if authenticated? %>
      <li class="nav-item">
        <%= link_to "Your Feed", feed_path, class: "nav-link #{ "active" if local_assigns[:your_feed] }" %>
      </li>
    <% end %>
    <li class="nav-item">
      <%= link_to "Global Feed", root_path, class: "nav-link #{ "active" if !local_assigns[:your_feed] && @tag.blank? }" %>
    </li>
    <% if @tag.present? %>
      <li class="nav-item">
        <a class="nav-link active"># <%= @tag %></a>
      </li>
    <% end %>
  </ul>
</div>
