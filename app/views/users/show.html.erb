<div class="profile-page">
  <div class="user-info">
    <div class="container">
      <div class="row">
        <div class="col-xs-12 col-md-10 offset-md-1">
          <%= avatar_tag @user, class: "user-img" %>
          <h4><%= @user.username %></h4>
          <% if @user.bio.present? %>
            <p><%= @user.bio %></p>
          <% end %>
          <%= render "users/follow_button", user: @user %>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col-xs-12 col-md-10 offset-md-1">
        <div class="articles-toggle">
          <ul class="nav nav-pills outline-active">
            <li class="nav-item">
              <%= link_to "My Articles", user_path(@user), class: "nav-link active" %>
            </li>
            <li class="nav-item">
              <%= link_to "Favorited Articles", user_favorites_path(@user), class: "nav-link" %>
            </li>
          </ul>
        </div>
        <%= render "articles/list", page: @page %>
      </div>
    </div>
  </div>
</div>
