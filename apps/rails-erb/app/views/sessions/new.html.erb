<div class="auth-page">
  <div class="container page">
    <div class="row">
      <div class="col-md-6 offset-md-3 col-xs-12">
        <h1 class="text-xs-center">Sign in</h1>
        <p class="text-xs-center">
          <%= link_to "Need an account?", new_registration_path %>
        </p>

        <%= form_with url: session_path do |form| %>
          <fieldset class="form-group">
            <%= form.label :email_address, "Email" %>
            <%= form.email_field :email_address, class: "form-control form-control-lg", placeholder: "Email", required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
          </fieldset>
          <fieldset class="form-group">
            <%= form.label :password, "Password" %>
            <%= form.password_field :password, class: "form-control form-control-lg", placeholder: "Password", required: true, autocomplete: "current-password", maxlength: 72 %>
          </fieldset>
          <%= form.submit "Sign in", class: "btn btn-lg btn-primary pull-xs-right" %>
        <% end %>

        <p><%= link_to "Forgot password?", new_password_path %></p>
      </div>
    </div>
  </div>
</div>
