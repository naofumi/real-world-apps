{
  "name": "naofumi/real-world-app-php",
  "description": "RealWorld (Conduit) blogging app in PHP 8.4 without a framework, using PDO + SQLite",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "league/commonmark": "^2.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate",
    "seed": "php bin/seed"
  },
  "config": {
    "sort-packages": true
  }
}
